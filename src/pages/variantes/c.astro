---
/**
 * VARIANTE C — « Haute tension »
 * Sombre premium : halos cyan/violet, cartes « verre », grille bento des
 * services. Positionnement technique (domotique, bornes de recharge).
 */
import '@fontsource-variable/space-grotesk';
import { Phone, Mail, Clock, MapPin, ArrowRight, Check, ChevronDown, Zap, Camera, Star, ShieldCheck, BadgeCheck, Timer, House, Lightbulb, PlugZap, Smartphone, Thermometer, Network, Wrench } from '@lucide/astro';
import Shell from '../../layouts/Shell.astro';
import VariantSwitcher from '../../components/VariantSwitcher.astro';
import IconWhatsApp from '../../components/IconWhatsApp.astro';
import { site, services, atouts, etapes, realisations, avis, faq } from '../../data/site';
import { href, telHref, formatPhone, whatsappHref, mailtoHref, digits } from '../../lib/utils';

const icons = { Zap, House, ShieldCheck, Lightbulb, PlugZap, Smartphone, Thermometer, Network, Wrench };
const wa = (text: string) => whatsappHref(site.whatsapp, text);
const waHello = wa(`Bonjour ${site.owner}, je souhaite un devis / renseignement pour `);
const nav = [['Services', '#services'], ['Atouts', '#atouts'], ['Zone', '#zone'], ['Réalisations', '#realisations'], ['Avis', '#avis'], ['FAQ', '#faq']];
const stats = [
  { icon: Timer, value: '24–48 h', label: 'Délai de dépannage' },
  { icon: BadgeCheck, value: 'NF C 15-100', label: 'Installations conformes' },
  { icon: ShieldCheck, value: '10 ans', label: 'Garantie décennale' },
];
/* Grille bento : la 1re carte est grande, la 6e est large. */
const span = (i: number) => (i === 0 ? 'lg:col-span-2 lg:row-span-2' : i === 5 ? 'lg:col-span-2' : '');
const glass = 'rounded-3xl bg-white/[0.04] ring-1 ring-white/10 backdrop-blur';
const year = new Date().getFullYear();
const h2 = 'text-3xl font-bold tracking-tight text-white sm:text-4xl';
const eyebrow = 'text-xs font-semibold uppercase tracking-[0.25em] text-cyan-400';
---
<Shell title="Variante C — Haute tension" bodyClass="font-grotesk bg-slate-950 text-slate-300" themeColor="#020617">
  <Fragment slot="head">
    <style>
      .glow-cyan { background: radial-gradient(closest-side, rgb(34 211 238 / 0.35), transparent); }
      .glow-violet { background: radial-gradient(closest-side, rgb(139 92 246 / 0.3), transparent); }
      .grid-bg { background-image: linear-gradient(to right, rgb(255 255 255 / 0.04) 1px, transparent 1px), linear-gradient(to bottom, rgb(255 255 255 / 0.04) 1px, transparent 1px); background-size: 48px 48px; mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%); }
      .text-gradient { background: linear-gradient(90deg, #22d3ee, #a78bfa); -webkit-background-clip: text; background-clip: text; color: transparent; }
    </style>
  </Fragment>

  <!-- En-tête -->
  <header class="sticky top-0 z-40 border-b border-white/10 bg-slate-950/70 backdrop-blur-xl">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
      <a href="#top" class="flex items-center gap-2.5 text-white">
        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-cyan-400 to-violet-500 text-slate-950"><Zap class="h-5 w-5" stroke-width={2.5} /></span>
        <span class="font-bold tracking-tight">{site.name}</span>
      </a>
      <nav class="hidden items-center gap-7 text-sm font-medium text-slate-400 lg:flex">{nav.map(([l, to]) => <a href={to} class="hover:text-white">{l}</a>)}</nav>
      <a href={telHref(site.phone)} class="inline-flex items-center gap-2 rounded-full bg-cyan-400 px-4 py-2.5 text-sm font-bold text-slate-950 hover:bg-cyan-300"><Phone class="h-4 w-4" stroke-width={2.5} /><span class="hidden sm:inline">{formatPhone(site.phone)}</span><span class="sm:hidden">Appeler</span></a>
    </div>
  </header>

  {site.enConstruction && <p class="border-b border-amber-400/20 bg-amber-400/10 px-4 py-2 text-center text-xs text-amber-200">Site en cours de création — les coordonnées affichées sont des exemples.</p>}

  <!-- Hero -->
  <section id="top" class="relative overflow-hidden">
    <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
    <div class="glow-cyan absolute -top-40 left-1/2 h-[36rem] w-[36rem] -translate-x-1/2 rounded-full" aria-hidden="true"></div>
    <div class="glow-violet absolute top-40 -right-40 h-[28rem] w-[28rem] rounded-full" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-4xl px-4 pt-20 pb-16 text-center sm:px-6 sm:pt-28 sm:pb-24">
      <p class="inline-flex items-center gap-2 rounded-full bg-white/5 px-3.5 py-1.5 text-xs font-medium text-slate-300 ring-1 ring-white/10"><span class="h-1.5 w-1.5 rounded-full bg-cyan-400 shadow-[0_0_10px_#22d3ee]"></span> Électricien indépendant · {site.address.city} et alentours</p>
      <h1 class="mt-6 text-4xl font-bold leading-[1.05] tracking-tight text-white sm:text-6xl lg:text-7xl">L'électricité, <span class="text-gradient">sans mauvaise surprise.</span></h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-slate-400">Dépannage, rénovation, mise aux normes, domotique, borne de recharge. Un artisan, un prix annoncé à l'avance, un travail conforme et durable.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="#contact" class="inline-flex items-center gap-2 rounded-full bg-cyan-400 px-6 py-3.5 text-sm font-bold text-slate-950 shadow-[0_0_40px_-8px_#22d3ee] hover:bg-cyan-300">Demander un devis <ArrowRight class="h-4 w-4" stroke-width={2.5} /></a>
        <a href={waHello} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full bg-white/5 px-6 py-3.5 text-sm font-bold text-white ring-1 ring-white/15 hover:bg-white/10"><IconWhatsApp class="h-4.5 w-4.5 text-[#25d366]" /> Écrire sur WhatsApp</a>
      </div>
      <ul class="mx-auto mt-14 grid max-w-3xl gap-3 sm:grid-cols-3">
        {stats.map(({ icon: Icon, value, label }) => (
          <li class={`${glass} flex items-center gap-4 p-4 text-left`}>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-cyan-400/10 text-cyan-400"><Icon class="h-5 w-5" /></span>
            <span><span class="block text-lg font-bold text-white">{value}</span><span class="block text-xs text-slate-400">{label}</span></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Services (bento) -->
  <section id="services" class="scroll-mt-20 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class={eyebrow}>Services</p>
      <h2 class={`${h2} mt-3`}>Tous vos travaux d'électricité</h2>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s, i) => {
          const Icon = icons[s.icon as keyof typeof icons] ?? Wrench;
          const big = i === 0;
          return (
            <li class={`${glass} group relative flex flex-col overflow-hidden p-6 transition hover:ring-cyan-400/40 ${span(i)}`}>
              {big && <span class="glow-cyan absolute -top-20 -right-20 h-64 w-64 rounded-full opacity-70" aria-hidden="true"></span>}
              <span class={`relative flex items-center justify-center rounded-2xl bg-gradient-to-br from-cyan-400/20 to-violet-500/20 text-cyan-300 ring-1 ring-white/10 ${big ? 'h-16 w-16' : 'h-12 w-12'}`}><Icon class={big ? 'h-8 w-8' : 'h-6 w-6'} /></span>
              <h3 class={`relative mt-5 font-bold text-white ${big ? 'text-2xl' : 'text-lg'}`}>{s.title}</h3>
              <p class={`relative mt-2 text-slate-400 ${big ? 'text-base' : 'text-sm'}`}>{s.description}</p>
              {big && (
                <div class="relative mt-6 flex-1">
                  <ul class="flex flex-wrap gap-2">
                    {['Panne totale', 'Disjoncteur qui saute', 'Court-circuit', 'Prise ou interrupteur HS', 'Odeur de brûlé'].map((t) => <li class="rounded-full bg-white/5 px-3 py-1 text-xs font-medium text-slate-300 ring-1 ring-white/10">{t}</li>)}
                  </ul>
                  <a href={telHref(site.phone)} class="mt-6 flex items-center gap-4 rounded-2xl bg-cyan-400/10 p-4 ring-1 ring-cyan-400/20 hover:bg-cyan-400/15">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-cyan-400 text-slate-950"><Phone class="h-5 w-5" stroke-width={2.5} /></span>
                    <span><span class="block text-xs text-cyan-200">Urgence ? Appelez directement</span><span class="block text-lg font-bold text-white">{formatPhone(site.phone)}</span></span>
                  </a>
                </div>
              )}
              {!big && <span class="flex-1"></span>}
              <a href={wa(`Bonjour ${site.owner}, je souhaite un devis pour ${s.devis}.`)} target="_blank" rel="noopener" class="relative mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-cyan-400 hover:text-cyan-300">Demander un devis <ArrowRight class="h-4 w-4 transition group-hover:translate-x-0.5" /></a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- Atouts + Étapes -->
  <section id="atouts" class="scroll-mt-20 py-16 sm:py-24">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class={eyebrow}>Pourquoi moi</p>
        <h2 class={`${h2} mt-3`}>Un artisan, pas un intermédiaire</h2>
        <p class="mt-4 text-lg text-slate-400">Je suis {site.owner}, électricien indépendant. Je réalise moi-même chaque intervention : vous parlez à la personne qui fera le travail, et vous la retrouvez sur le chantier.</p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {atouts.map((a) => (
            <li class="flex gap-3 rounded-2xl bg-white/[0.03] p-4 ring-1 ring-white/5">
              <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-cyan-400 text-slate-950"><Check class="h-3.5 w-3.5" stroke-width={3} /></span>
              <span><span class="block text-sm font-bold text-white">{a.title}</span><span class="block text-xs leading-relaxed text-slate-400">{a.text}</span></span>
            </li>
          ))}
        </ul>
      </div>
      <div class={`${glass} p-7 sm:p-9`}>
        <p class={eyebrow}>Comment ça se passe</p>
        <h3 class="mt-3 text-2xl font-bold text-white">Simple, en trois étapes</h3>
        <ol class="relative mt-8 space-y-8 border-l border-cyan-400/30 pl-8">
          {etapes.map((e, i) => (
            <li class="relative">
              <span class="absolute -left-[2.6rem] flex h-8 w-8 items-center justify-center rounded-full bg-slate-950 text-sm font-bold text-cyan-400 ring-2 ring-cyan-400 shadow-[0_0_16px_#22d3ee80]">{i + 1}</span>
              <h4 class="font-bold text-white">{e.title}</h4>
              <p class="mt-1 text-sm text-slate-400">{e.text}</p>
            </li>
          ))}
        </ol>
        <a href="#contact" class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-bold text-slate-950 hover:bg-slate-200">Demander un devis gratuit <ArrowRight class="h-4 w-4" /></a>
      </div>
    </div>
  </section>

  <!-- Zone -->
  <section id="zone" class="relative scroll-mt-20 overflow-hidden py-16 sm:py-24">
    <div class="glow-violet absolute top-1/2 left-1/2 h-[30rem] w-[30rem] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-60" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl items-center gap-10 px-4 sm:px-6 lg:grid-cols-2">
      <div>
        <p class={eyebrow}>Zone d'intervention</p>
        <h2 class={`${h2} mt-3`}>{site.address.city} et ses environs</h2>
        <p class="mt-4 max-w-xl text-lg text-slate-400">J'interviens à {site.address.city} et dans un rayon d'environ {site.radiusKm} km. Pour un chantier plus éloigné, contactez-moi : je me déplace selon l'ampleur des travaux.</p>
        {site.zones.length > 0 && <ul class="mt-6 flex flex-wrap gap-2">{site.zones.map((z) => <li class="rounded-full bg-white/5 px-3.5 py-1.5 text-sm font-medium text-slate-200 ring-1 ring-white/10">{z}</li>)}</ul>}
      </div>
      <div class="relative mx-auto flex h-72 w-72 items-center justify-center sm:h-80 sm:w-80">
        <span class="absolute inset-0 rounded-full border border-cyan-400/20"></span>
        <span class="absolute inset-10 rounded-full border border-cyan-400/30"></span>
        <span class="absolute inset-20 rounded-full border border-cyan-400/40 bg-cyan-400/5"></span>
        <span class="absolute inset-0 rounded-full border-t-2 border-cyan-400/60 [mask-image:conic-gradient(from_0deg,black,transparent_60%)]"></span>
        <span class="relative flex flex-col items-center gap-1.5"><MapPin class="h-8 w-8 text-cyan-400" /><span class="rounded-full bg-white px-3 py-1 text-sm font-bold text-slate-950">{site.address.city}</span><span class="text-xs text-slate-400">≈ {site.radiusKm} km</span></span>
      </div>
    </div>
  </section>

  <!-- Réalisations -->
  <section id="realisations" class="scroll-mt-20 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <p class={eyebrow}>Réalisations</p>
      <h2 class={`${h2} mt-3`}>Quelques chantiers récents</h2>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {realisations.map((r) => (
          <li class={`${glass} group overflow-hidden`}>
            <div class="flex aspect-[4/3] items-center justify-center bg-gradient-to-br from-cyan-400/15 via-slate-900 to-violet-500/20 text-slate-500">
              {r.image ? <img src={href(r.image)} alt={r.title} loading="lazy" width="800" height="600" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /> : <span class="flex flex-col items-center gap-2"><Zap class="h-10 w-10 text-cyan-400" /><span class="inline-flex items-center gap-1.5 text-xs"><Camera class="h-3.5 w-3.5" /> Photo à venir</span></span>}
            </div>
            <div class="p-5"><h3 class="font-bold text-white">{r.title}</h3><p class="mt-1 text-sm text-slate-400">{r.text}</p></div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Avis -->
  <section id="avis" class="scroll-mt-20 py-16 sm:py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div><p class={eyebrow}>Avis clients</p><h2 class={`${h2} mt-3`}>Ils m'ont fait confiance</h2></div>
        {site.enConstruction && <span class="rounded-full bg-amber-400/10 px-3 py-1 text-xs font-medium text-amber-200 ring-1 ring-amber-400/20">Exemples d'avis — à remplacer</span>}
      </div>
      <ul class="mt-10 grid gap-5 md:grid-cols-3">
        {avis.map((a) => (
          <li class={`${glass} flex flex-col p-7`}>
            <div class="flex gap-0.5 text-cyan-400">{Array.from({ length: a.rating }).map(() => <Star class="h-4 w-4 fill-current" />)}</div>
            <p class="mt-4 flex-1 leading-relaxed text-slate-300">« {a.text} »</p>
            <p class="mt-5 text-sm font-bold text-white">{a.author}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="scroll-mt-20 py-16 sm:py-24">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr]">
      <div><p class={eyebrow}>Questions fréquentes</p><h2 class={`${h2} mt-3`}>Vous vous demandez…</h2><p class="mt-4 text-slate-400">Une autre question ? Appelez-moi ou écrivez-moi, je vous réponds rapidement.</p></div>
      <div class={`${glass} divide-y divide-white/10 px-6`}>
        {faq.map((f) => (
          <details class="group">
            <summary class="flex cursor-pointer items-center justify-between gap-4 py-5 font-semibold text-white">{f.q}<ChevronDown class="h-5 w-5 shrink-0 text-slate-500 transition group-open:rotate-180" /></summary>
            <p class="pb-5 text-sm leading-relaxed text-slate-400">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="relative scroll-mt-20 overflow-hidden py-16 sm:py-24">
    <div class="glow-cyan absolute -bottom-40 left-1/2 h-[30rem] w-[40rem] -translate-x-1/2 rounded-full opacity-50" aria-hidden="true"></div>
    <div class="relative mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class={eyebrow}>Contact & devis</p>
        <h2 class={`${h2} mt-3`}>Parlons de votre projet</h2>
        <p class="mt-4 text-lg text-slate-400">Décrivez votre besoin, envoyez une photo si possible : je vous réponds rapidement avec un premier avis et un devis gratuit.</p>
        <ul class="mt-8 space-y-3">
          <li><a href={telHref(site.phone)} class={`${glass} flex items-center gap-4 p-4 hover:ring-cyan-400/40`}><Phone class="h-5 w-5 text-cyan-400" /><span><span class="block text-xs text-slate-500">Téléphone</span><span class="block font-bold text-white">{formatPhone(site.phone)}</span></span></a></li>
          <li><a href={waHello} target="_blank" rel="noopener" class={`${glass} flex items-center gap-4 p-4 hover:ring-[#25d366]/40`}><IconWhatsApp class="h-5 w-5 text-[#25d366]" /><span><span class="block text-xs text-slate-500">WhatsApp</span><span class="block font-bold text-white">{formatPhone(site.whatsapp)}</span></span></a></li>
          <li><a href={mailtoHref(site.email, 'Demande de devis')} class={`${glass} flex items-center gap-4 p-4 hover:ring-cyan-400/40`}><Mail class="h-5 w-5 text-cyan-400" /><span><span class="block text-xs text-slate-500">E-mail</span><span class="block font-bold break-all text-white">{site.email}</span></span></a></li>
          <li class="flex items-center gap-4 p-4 text-sm"><Clock class="h-5 w-5 text-cyan-400" /><span>{site.hours.map((h) => <span class="block"><span class="font-bold text-white">{h.label}</span> : {h.opens.replace(':', 'h')} – {h.closes.replace(':', 'h')}</span>)}</span></li>
        </ul>
      </div>
      <form data-wa={digits(site.whatsapp)} data-email={site.email} data-owner={site.owner} novalidate class={`${glass} p-6 sm:p-8`}>
        <h3 class="text-xl font-bold text-white">Demande de devis</h3>
        <p class="mt-1 text-sm text-slate-400">Le message est préparé pour vous, puis envoyé depuis votre WhatsApp ou votre messagerie.</p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <label class="block text-sm font-medium text-slate-300">Votre nom<input name="nom" required placeholder="Prénom Nom" class="mt-1.5 block w-full rounded-xl border border-white/10 bg-slate-900/80 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-400/20" /></label>
          <label class="block text-sm font-medium text-slate-300">Votre téléphone<input name="tel" type="tel" required placeholder="06 00 00 00 00" class="mt-1.5 block w-full rounded-xl border border-white/10 bg-slate-900/80 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-400/20" /></label>
          <label class="block text-sm font-medium text-slate-300 sm:col-span-2">Votre demande<select name="type" class="mt-1.5 block w-full rounded-xl border border-white/10 bg-slate-900/80 px-4 py-3 text-sm text-white focus:border-cyan-400 focus:outline-none">{services.map((s) => <option value={s.title}>{s.title}</option>)}<option value="Autre demande">Autre demande</option></select></label>
          <label class="block text-sm font-medium text-slate-300 sm:col-span-2">Détails <span class="text-slate-500">(facultatif)</span><textarea name="message" rows="4" placeholder="Décrivez votre besoin, le type de logement, l'urgence…" class="mt-1.5 block w-full rounded-xl border border-white/10 bg-slate-900/80 px-4 py-3 text-sm text-white placeholder:text-slate-500 focus:border-cyan-400 focus:outline-none focus:ring-2 focus:ring-cyan-400/20"></textarea></label>
        </div>
        <p data-error class="mt-3 hidden text-sm font-semibold text-red-400" role="alert"></p>
        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <button type="submit" data-via="whatsapp" class="inline-flex items-center justify-center gap-2 rounded-full bg-[#25d366] px-5 py-3.5 text-sm font-bold text-white hover:bg-[#1ebe5d]"><IconWhatsApp class="h-4.5 w-4.5" /> Envoyer sur WhatsApp</button>
          <button type="submit" data-via="email" class="inline-flex items-center justify-center gap-2 rounded-full bg-white/10 px-5 py-3.5 text-sm font-bold text-white ring-1 ring-white/15 hover:bg-white/15"><Mail class="h-4 w-4" /> Envoyer par e-mail</button>
        </div>
      </form>
    </div>
  </section>

  <footer class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-8 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p><span class="font-bold text-white">{site.name}</span> · © {year} · {site.legal.form} · SIRET {site.legal.siret}</p>
      <p class="flex gap-4"><a href={href('/mentions-legales/')} class="hover:text-white">Mentions légales</a><a href={href('/confidentialite/')} class="hover:text-white">Confidentialité</a></p>
    </div>
  </footer>

  <a href={waHello} target="_blank" rel="noopener" aria-label="Écrire sur WhatsApp" class="fixed right-4 bottom-4 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25d366] text-white shadow-[0_0_30px_-5px_#25d366] hover:bg-[#1ebe5d] sm:right-6 sm:bottom-6"><IconWhatsApp class="h-7 w-7" /></a>
  <VariantSwitcher current="c" />
</Shell>

<script src="../../lib/form-contact.ts"></script>
