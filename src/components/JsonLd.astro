---
/**
 * Données structurées schema.org (type « Electrician ») : aide Google à
 * afficher l'entreprise comme un commerce local (téléphone, horaires, zone).
 */
import { site } from '../data/site';
import { absolute } from '../lib/utils';

const url = absolute('/', Astro.site);
const data = {
  '@context': 'https://schema.org',
  '@type': 'Electrician',
  '@id': `${url}#entreprise`,
  name: site.name,
  description: site.description,
  url,
  image: absolute('/og.png', Astro.site),
  logo: absolute('/apple-touch-icon.png', Astro.site),
  telephone: site.phone,
  email: site.email,
  priceRange: '€€',
  currenciesAccepted: 'EUR',
  address: {
    '@type': 'PostalAddress',
    ...(site.address.street ? { streetAddress: site.address.street } : {}),
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    ...(site.address.department ? { addressRegion: site.address.department } : {}),
    addressCountry: 'FR',
  },
  areaServed: [site.address.city, ...site.zones].map((name) => ({ '@type': 'City', name })),
  openingHoursSpecification: site.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  })),
  ...(Object.values(site.social).some(Boolean)
    ? { sameAs: Object.values(site.social).filter(Boolean) }
    : {}),
};
---
<script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
