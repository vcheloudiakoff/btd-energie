---
import { ChevronDown } from '@lucide/astro';
import { faq } from '../data/site';
---
<section id="faq" class="section scroll-mt-20 bg-slate-50">
  <div class="container-x grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <span class="eyebrow">Questions fréquentes</span>
      <h2 class="h2">Vous vous demandez…</h2>
      <p class="lead">Une autre question ? Appelez-moi ou écrivez-moi, je vous réponds rapidement.</p>
    </div>

    <div class="divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white shadow-sm">
      {faq.map((item) => (
        <details class="group px-6">
          <summary class="flex cursor-pointer items-center justify-between gap-4 py-5 text-left font-semibold text-navy-900">
            {item.q}
            <ChevronDown class="faq-chevron h-5 w-5 shrink-0 text-slate-400 transition" />
          </summary>
          <p class="pb-5 text-sm leading-relaxed text-slate-600">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
