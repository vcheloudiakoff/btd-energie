---
import { ChevronDown } from '@lucide/astro';
import { faq } from '../data/site';
---
<section id="faq" class="section scroll-mt-24">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">Questions fréquentes</span>
      <h2 class="h2">Vous vous demandez…</h2>
      <p class="lead">Une autre question ? Appelez-moi ou écrivez-moi, je vous réponds rapidement.</p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {faq.map((item) => (
        <details class="group rounded-3xl bg-white p-6 ring-1 ring-slate-200 open:ring-teal-300">
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-bold text-slate-900">
            {item.q}
            <ChevronDown class="h-5 w-5 shrink-0 text-slate-400 transition group-open:rotate-180" />
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
