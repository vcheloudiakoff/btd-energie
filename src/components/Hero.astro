---
import { Phone, ArrowRight, Check, Zap, Camera, Timer, FileCheck } from '@lucide/astro';
import { site } from '../data/site';
import { href, telHref, formatPhone, whatsappHref } from '../lib/utils';
import IconWhatsApp from './IconWhatsApp.astro';

const waHello = whatsappHref(site.whatsapp, `Bonjour ${site.owner}, je souhaite un devis / renseignement pour `);
---
<section class="relative overflow-hidden bg-gradient-to-br from-teal-50 via-white to-amber-50">
  <div class="container-x grid items-center gap-12 py-16 sm:py-24 lg:grid-cols-2">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full bg-white px-3.5 py-1.5 text-sm font-semibold text-teal-800 shadow-sm ring-1 ring-teal-100">
        <span class="h-2 w-2 rounded-full bg-teal-500"></span> Électricien indépendant · {site.address.city}
      </p>
      <h1 class="mt-5 text-4xl font-extrabold leading-[1.1] tracking-tight text-slate-900 sm:text-5xl lg:text-[3.4rem]">
        L'électricité de votre maison, <span class="text-teal-700">entre de bonnes mains.</span>
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-slate-600">
        Dépannage, installation, mise aux normes, éclairage, borne de recharge. Je suis {site.owner} :
        je vous conseille, je chiffre clairement, et je réalise moi-même les travaux.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={href('/#contact')} class="btn-primary">Demander un devis <ArrowRight class="h-4 w-4" /></a>
        <a href={telHref(site.phone)} class="btn-light"><Phone class="h-4 w-4 text-teal-700" /> {formatPhone(site.phone)}</a>
      </div>
      <ul class="mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-slate-600">
        {['Devis gratuit', 'Intervention sous 24–48 h', 'Assurance décennale'].map((t) => (
          <li class="flex items-center gap-1.5"><Check class="h-4 w-4 text-teal-600" stroke-width={3} /> {t}</li>
        ))}
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-md lg:max-w-none">
      <div class="flex aspect-[4/5] items-center justify-center overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-teal-600 to-emerald-500 shadow-2xl shadow-teal-700/30 sm:aspect-[5/4] lg:aspect-[4/5]">
        {site.photo ? (
          <img src={href(site.photo)} alt={`${site.owner}, électricien`} width="800" height="1000" class="h-full w-full object-cover" />
        ) : (
          <div class="flex flex-col items-center gap-2 text-white/80">
            <Zap class="h-20 w-20 text-white" stroke-width={1.5} />
            <span class="inline-flex items-center gap-1.5 text-sm font-medium"><Camera class="h-4 w-4" /> Photo de {site.owner} à venir</span>
          </div>
        )}
      </div>
      <div class="absolute -left-4 top-8 flex items-center gap-3 rounded-2xl bg-white p-3.5 pr-5 shadow-xl ring-1 ring-slate-100 sm:-left-8">
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-amber-100 text-amber-700"><Timer class="h-5 w-5" /></span>
        <span><span class="block text-xs font-medium text-slate-500">Dépannage</span><span class="block text-sm font-bold text-slate-900">Sous 24 à 48 h</span></span>
      </div>
      <div class="absolute -right-3 bottom-20 flex items-center gap-3 rounded-2xl bg-white p-3.5 pr-5 shadow-xl ring-1 ring-slate-100 sm:-right-8 sm:bottom-10">
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-teal-100 text-teal-700"><FileCheck class="h-5 w-5" /></span>
        <span><span class="block text-xs font-medium text-slate-500">Devis</span><span class="block text-sm font-bold text-slate-900">Gratuit et détaillé</span></span>
      </div>
      <a href={waHello} target="_blank" rel="noopener" class="btn-wa absolute -bottom-5 left-1/2 -translate-x-1/2 shadow-xl">
        <IconWhatsApp class="h-5 w-5" /> Écrire sur WhatsApp
      </a>
    </div>
  </div>
</section>
