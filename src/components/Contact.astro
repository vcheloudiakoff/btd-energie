---
import { Phone, Mail, Clock, MapPin } from '@lucide/astro';
import { site, services } from '../data/site';
import { telHref, formatPhone, whatsappHref, mailtoHref, digits } from '../lib/utils';
import IconWhatsApp from './IconWhatsApp.astro';

const waHello = whatsappHref(site.whatsapp, `Bonjour ${site.owner}, `);
const ligne = 'flex items-center gap-4 rounded-2xl bg-white/10 p-4 transition hover:bg-white/15';
---
<section id="contact" class="scroll-mt-24 px-4 pb-20 sm:px-6 sm:pb-28">
  <div class="mx-auto grid max-w-6xl gap-10 overflow-hidden rounded-[2.5rem] bg-teal-800 p-6 text-white sm:p-10 lg:grid-cols-[0.9fr_1.1fr] lg:p-14">
    <div>
      <span class="eyebrow text-teal-200!">Contact & devis</span>
      <h2 class="h2 text-white!">Parlons de votre projet</h2>
      <p class="lead text-teal-50!">
        Décrivez votre besoin, envoyez une photo si possible : je vous réponds rapidement avec un premier avis et un devis gratuit.
      </p>
      <ul class="mt-8 space-y-4">
        <li><a href={telHref(site.phone)} class={ligne}><Phone class="h-5 w-5 text-amber-300" /><span><span class="block text-xs text-teal-200">Téléphone</span><span class="block font-bold">{formatPhone(site.phone)}</span></span></a></li>
        <li><a href={waHello} target="_blank" rel="noopener" class={ligne}><IconWhatsApp class="h-5 w-5 text-wa-500" /><span><span class="block text-xs text-teal-200">WhatsApp</span><span class="block font-bold">{formatPhone(site.whatsapp)}</span></span></a></li>
        <li><a href={mailtoHref(site.email, 'Demande de devis')} class={ligne}><Mail class="h-5 w-5 text-amber-300" /><span><span class="block text-xs text-teal-200">E-mail</span><span class="block font-bold break-all">{site.email}</span></span></a></li>
        <li class="flex items-center gap-4 p-4 text-sm"><Clock class="h-5 w-5 shrink-0 text-amber-300" /><span>{site.hours.map((h) => <span class="block"><span class="font-bold">{h.label}</span> : {h.opens.replace(':', 'h')} – {h.closes.replace(':', 'h')}</span>)}</span></li>
        <li class="flex items-center gap-4 px-4 text-sm"><MapPin class="h-5 w-5 shrink-0 text-amber-300" /><span>{site.address.city} et alentours ({site.radiusKm} km)</span></li>
      </ul>
    </div>

    <form data-wa={digits(site.whatsapp)} data-email={site.email} data-owner={site.owner} novalidate class="rounded-3xl bg-white p-6 text-slate-700 sm:p-8">
      <h3 class="text-xl font-extrabold text-slate-900">Demande de devis</h3>
      <p class="mt-1 text-sm text-slate-500">Le message est préparé pour vous, puis envoyé depuis votre WhatsApp ou votre messagerie.</p>

      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="nom" class="label">Votre nom</label>
          <input id="nom" name="nom" type="text" class="field" autocomplete="name" required placeholder="Prénom Nom" />
        </div>
        <div>
          <label for="tel" class="label">Votre téléphone</label>
          <input id="tel" name="tel" type="tel" class="field" autocomplete="tel" required placeholder="06 00 00 00 00" />
        </div>
        <div class="sm:col-span-2">
          <label for="type" class="label">Votre demande</label>
          <select id="type" name="type" class="field">
            {services.map((s) => <option value={s.title}>{s.title}</option>)}
            <option value="Autre demande">Autre demande</option>
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="message" class="label">Détails <span class="font-normal text-slate-400">(facultatif)</span></label>
          <textarea id="message" name="message" rows="4" class="field" placeholder="Décrivez votre besoin, le type de logement, l'urgence…"></textarea>
        </div>
      </div>

      <p data-error class="mt-3 hidden text-sm font-semibold text-red-600" role="alert"></p>

      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        <button type="submit" data-via="whatsapp" class="btn-wa"><IconWhatsApp class="h-4.5 w-4.5" /> Envoyer sur WhatsApp</button>
        <button type="submit" data-via="email" class="btn bg-slate-100 text-slate-900 hover:bg-slate-200"><Mail class="h-4 w-4" /> Envoyer par e-mail</button>
      </div>

      <p class="mt-4 text-xs leading-relaxed text-slate-500">
        Aucune donnée n'est stockée par ce site : votre message part directement depuis votre application, vers {site.owner} uniquement.
        Pour une urgence, préférez l'appel au <a href={telHref(site.phone)} class="font-semibold text-slate-900 underline">{formatPhone(site.phone)}</a>.
      </p>
    </form>
  </div>
</section>

<script src="../lib/form-contact.ts"></script>
