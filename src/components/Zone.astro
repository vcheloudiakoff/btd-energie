---
import { MapPin } from '@lucide/astro';
import { site } from '../data/site';
---
<section id="zone" class="scroll-mt-24 bg-teal-700 text-white">
  <div class="container-x grid items-center gap-10 py-16 sm:py-20 lg:grid-cols-[1.2fr_0.8fr]">
    <div>
      <span class="eyebrow text-teal-200!">Zone d'intervention</span>
      <h2 class="h2 text-white!">{site.address.city} et ses environs</h2>
      <p class="lead max-w-xl text-teal-50!">
        J'interviens à {site.address.city} et dans un rayon d'environ {site.radiusKm} km
        {site.address.department && <> ({site.address.department})</>}.
        Pour un chantier plus éloigné, contactez-moi : je me déplace selon l'ampleur des travaux.
      </p>
      {site.zones.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2">
          {site.zones.map((z) => <li class="rounded-full bg-white/15 px-3.5 py-1.5 text-sm font-semibold">{z}</li>)}
        </ul>
      )}
    </div>
    <div class="relative mx-auto flex h-64 w-64 items-center justify-center sm:h-72 sm:w-72" aria-hidden="true">
      <span class="absolute inset-0 rounded-full bg-white/10"></span>
      <span class="absolute inset-8 rounded-full bg-white/10"></span>
      <span class="absolute inset-16 rounded-full bg-white/15"></span>
      <span class="relative flex flex-col items-center gap-1">
        <MapPin class="h-10 w-10 text-amber-300" />
        <span class="rounded-full bg-white px-3 py-1 text-sm font-bold text-teal-800">{site.address.city}</span>
        <span class="text-xs text-teal-100">≈ {site.radiusKm} km</span>
      </span>
    </div>
  </div>
</section>
