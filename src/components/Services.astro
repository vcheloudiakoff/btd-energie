---
import { Zap, House, ShieldCheck, Lightbulb, PlugZap, Smartphone, Thermometer, Network, Wrench, ArrowRight } from '@lucide/astro';
import { site, services } from '../data/site';
import { whatsappHref } from '../lib/utils';

/** Icônes Lucide autorisées dans src/data/site.ts (champ `icon`). */
const icons = { Zap, House, ShieldCheck, Lightbulb, PlugZap, Smartphone, Thermometer, Network, Wrench };
type IconName = keyof typeof icons;
---
<section id="services" class="section scroll-mt-24">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">Services</span>
      <h2 class="h2">Tous vos travaux d'électricité</h2>
      <p class="lead">Du simple dépannage à la rénovation complète, pour les particuliers comme pour les professionnels.</p>
    </div>

    <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => {
        const Icon = icons[s.icon as IconName] ?? Wrench;
        const wa = whatsappHref(site.whatsapp, `Bonjour ${site.owner}, je souhaite un devis pour ${s.devis}.`);
        return (
          <li class="card group transition hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-200/60">
            <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-teal-50 text-teal-700 transition group-hover:bg-teal-700 group-hover:text-white">
              <Icon class="h-7 w-7" />
            </span>
            <h3 class="mt-6 text-lg font-bold text-slate-900">{s.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.description}</p>
            <a href={wa} target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-teal-700 hover:text-teal-900">
              Demander un devis <ArrowRight class="h-4 w-4 transition group-hover:translate-x-0.5" />
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
