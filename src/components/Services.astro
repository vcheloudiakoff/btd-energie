---
import { Zap, House, ShieldCheck, Lightbulb, PlugZap, Smartphone, Thermometer, Network, Wrench, ArrowUpRight } from '@lucide/astro';
import { site, services } from '../data/site';
import { whatsappHref } from '../lib/utils';

/** Icônes Lucide autorisées dans src/data/site.ts (champ `icon`). */
const icons = { Zap, House, ShieldCheck, Lightbulb, PlugZap, Smartphone, Thermometer, Network, Wrench };
type IconName = keyof typeof icons;
---
<section id="services" class="section scroll-mt-20">
  <div class="container-x">
    <div class="max-w-2xl">
      <span class="eyebrow">Services</span>
      <h2 class="h2">Tous vos travaux d’électricité</h2>
      <p class="lead">
        Du simple dépannage à la rénovation complète, pour les particuliers comme pour les professionnels.
      </p>
    </div>

    <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s) => {
        const Icon = icons[s.icon as IconName] ?? Wrench;
        const wa = whatsappHref(site.whatsapp, `Bonjour ${site.owner}, je souhaite un devis pour ${s.devis}.`);
        return (
          <li class="card group flex flex-col transition hover:-translate-y-0.5 hover:shadow-md">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-100 text-brand-700">
              <Icon class="h-6 w-6" />
            </span>
            <h3 class="mt-5 text-lg font-bold text-navy-900">{s.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{s.description}</p>
            <a
              href={wa}
              target="_blank"
              rel="noopener"
              class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-navy-800 hover:text-brand-700"
            >
              Demander un devis <ArrowUpRight class="h-4 w-4 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>
