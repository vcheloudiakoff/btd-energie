---
import { Star, ExternalLink } from '@lucide/astro';
import { site, avis } from '../data/site';

const initiales = (nom: string) => nom.split(' ').map((p) => p[0]).join('').toUpperCase();
---
<section id="avis" class="section scroll-mt-24 bg-slate-50">
  <div class="container-x">
    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow">Avis clients</span>
      <h2 class="h2">Ils m'ont fait confiance</h2>
      {site.enConstruction && (
        <p class="mt-3 inline-block rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">
          Exemples d'avis — seront remplacés par de vrais avis Google
        </p>
      )}
    </div>

    <ul class="mt-12 grid gap-6 md:grid-cols-3">
      {avis.map((a) => (
        <li class="card flex flex-col">
          <div class="flex gap-0.5 text-amber-400" aria-label={`${a.rating} étoiles sur 5`}>
            {Array.from({ length: 5 }).map((_, i) => (
              <Star class={`h-4.5 w-4.5 ${i < a.rating ? 'fill-current' : 'text-slate-300'}`} />
            ))}
          </div>
          <blockquote class="mt-4 flex-1 leading-relaxed text-slate-700">« {a.text} »</blockquote>
          <p class="mt-6 flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-teal-100 text-sm font-bold text-teal-800">{initiales(a.author)}</span>
            <span class="font-bold text-slate-900">{a.author}</span>
          </p>
        </li>
      ))}
    </ul>

    {site.social.google && (
      <div class="mt-10 text-center">
        <a href={site.social.google} target="_blank" rel="noopener" class="btn-light">Voir tous les avis Google <ExternalLink class="h-4 w-4" /></a>
      </div>
    )}
  </div>
</section>
