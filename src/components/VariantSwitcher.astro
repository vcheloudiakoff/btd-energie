---
/** Petite barre flottante pour passer d'une variante de design à l'autre. */
import { href } from '../lib/utils';
interface Props { current: 'original' | 'a' | 'b' | 'c'; class?: string }
const { current, class: className = 'bottom-4' } = Astro.props;
const items = [
  { id: 'original', label: 'Original', to: '/' },
  { id: 'a', label: 'A', to: '/variantes/a/' },
  { id: 'b', label: 'B', to: '/variantes/b/' },
  { id: 'c', label: 'C', to: '/variantes/c/' },
];
---
<nav
  class={`fixed left-4 z-[60] flex items-center gap-1 rounded-full bg-slate-900/90 p-1 text-xs font-semibold text-white shadow-lg ring-1 ring-white/15 backdrop-blur ${className}`}
  aria-label="Comparer les variantes de design"
>
  <a href={href('/variantes/')} class="rounded-full px-2.5 py-1.5 text-slate-300 hover:text-white" title="Toutes les variantes">Design</a>
  {items.map((i) => (
    <a
      href={href(i.to)}
      class={`rounded-full px-2.5 py-1.5 ${i.id === current ? 'bg-white text-slate-900' : 'text-slate-300 hover:bg-white/10 hover:text-white'}`}
      aria-current={i.id === current ? 'page' : undefined}
    >
      {i.label}
    </a>
  ))}
</nav>
