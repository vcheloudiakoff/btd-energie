---
import { Zap, Camera } from '@lucide/astro';
import { realisations } from '../data/site';
import { href } from '../lib/utils';
---
<section id="realisations" class="section scroll-mt-24">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="eyebrow">Réalisations</span>
        <h2 class="h2">Quelques chantiers récents</h2>
      </div>
      <p class="max-w-sm text-slate-600">Des interventions soignées, du petit dépannage à la rénovation complète.</p>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {realisations.map((r) => (
        <li class="group overflow-hidden rounded-3xl bg-white ring-1 ring-slate-200">
          <div class="flex aspect-[4/3] items-center justify-center overflow-hidden bg-gradient-to-br from-slate-100 to-teal-50 text-slate-400">
            {r.image ? (
              <img src={href(r.image)} alt={r.title} loading="lazy" decoding="async" width="800" height="600" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
            ) : (
              <span class="flex flex-col items-center gap-2">
                <Zap class="h-10 w-10 text-teal-600" />
                <span class="inline-flex items-center gap-1.5 text-xs font-medium"><Camera class="h-3.5 w-3.5" /> Photo à venir</span>
              </span>
            )}
          </div>
          <div class="p-6">
            <h3 class="font-bold text-slate-900">{r.title}</h3>
            <p class="mt-1 text-sm text-slate-600">{r.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
