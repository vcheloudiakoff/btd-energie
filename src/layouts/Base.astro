---
import '../styles/global.css';
import { site } from '../data/site';
import { href, absolute } from '../lib/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import JsonLd from '../components/JsonLd.astro';
import { Construction } from '@lucide/astro';

interface Props {
  /** Titre de la page (sans le nom du site). Vide = page d'accueil. */
  title?: string;
  description?: string;
  /** Exclure la page des moteurs de recherche (pages légales, 404). */
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = absolute('/og.png', Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <meta name="theme-color" content="#0b1b36" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="generator" content={Astro.generator} />

    <JsonLd />
  </head>
  <body class="flex min-h-dvh flex-col bg-white font-sans text-slate-800 antialiased">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-lg focus:bg-navy-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Aller au contenu
    </a>

    <Header />

    {site.enConstruction && (
      <div class="no-print border-b border-brand-300 bg-brand-100 text-center text-sm text-brand-700" role="status">
        <p class="container-x flex items-center justify-center gap-2 py-2">
          <Construction class="h-4 w-4 shrink-0" />
          <span>Site en cours de création — les coordonnées affichées sont des exemples.</span>
        </p>
      </div>
    )}

    <main id="contenu" class="flex-1">
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />
  </body>
</html>
